<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 200" width="800" height="200">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0b1026"/>
      <stop offset="1" stop-color="#1a1440"/>
    </linearGradient>
    <style>
      .t { fill: #fff; animation: twinkle 3s ease-in-out infinite; }
      .sp { fill: #ffe9a8; animation: glitter 2.5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
      @keyframes twinkle { 0%,100% { opacity: .15; } 50% { opacity: 1; } }
      @keyframes glitter { 0%,100% { opacity: .2; transform: scale(.5); } 50% { opacity: 1; transform: scale(1.2); } }
      .name { font: bold 44px 'Segoe UI', Arial, sans-serif; fill: #fff; }
    </style>
  </defs>

  <rect width="800" height="200" fill="url(#sky)"/>

  <!-- small twinkling stars -->
  <circle class="t" cx="40"  cy="30"  r="1.5" style="animation-delay:0s"/>
  <circle class="t" cx="95"  cy="150" r="1.2" style="animation-delay:.6s"/>
  <circle class="t" cx="150" cy="60"  r="1.8" style="animation-delay:1.2s"/>
  <circle class="t" cx="210" cy="170" r="1.3" style="animation-delay:1.8s"/>
  <circle class="t" cx="270" cy="25"  r="1.6" style="animation-delay:.3s"/>
  <circle class="t" cx="330" cy="130" r="1.2" style="animation-delay:2.1s"/>
  <circle class="t" cx="390" cy="20"  r="1.5" style="animation-delay:.9s"/>
  <circle class="t" cx="450" cy="175" r="1.7" style="animation-delay:1.5s"/>
  <circle class="t" cx="510" cy="45"  r="1.3" style="animation-delay:2.4s"/>
  <circle class="t" cx="570" cy="140" r="1.5" style="animation-delay:.2s"/>
  <circle class="t" cx="630" cy="30"  r="1.8" style="animation-delay:1s"/>
  <circle class="t" cx="690" cy="165" r="1.2" style="animation-delay:1.7s"/>
  <circle class="t" cx="750" cy="70"  r="1.6" style="animation-delay:2.7s"/>
  <circle class="t" cx="20"  cy="110" r="1.2" style="animation-delay:1.4s"/>
  <circle class="t" cx="125" cy="100" r="1"   style="animation-delay:2.2s"/>
  <circle class="t" cx="300" cy="80"  r="1"   style="animation-delay:.5s"/>
  <circle class="t" cx="480" cy="110" r="1"   style="animation-delay:1.9s"/>
  <circle class="t" cx="660" cy="100" r="1"   style="animation-delay:.8s"/>
  <circle class="t" cx="770" cy="150" r="1.4" style="animation-delay:2s"/>
  <circle class="t" cx="60"  cy="185" r="1.1" style="animation-delay:1.1s"/>

  <!-- bigger glittering sparkles -->
  <path class="sp" transform="translate(70,70)"   style="animation-delay:0s"   d="M0,-8 L2,-2 L8,0 L2,2 L0,8 L-2,2 L-8,0 L-2,-2 Z"/>
  <path class="sp" transform="translate(240,40)"  style="animation-delay:.8s"  d="M0,-8 L2,-2 L8,0 L2,2 L0,8 L-2,2 L-8,0 L-2,-2 Z"/>
  <path class="sp" transform="translate(360,165)" style="animation-delay:1.6s" d="M0,-8 L2,-2 L8,0 L2,2 L0,8 L-2,2 L-8,0 L-2,-2 Z"/>
